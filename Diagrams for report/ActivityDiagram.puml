@startuml
start

:User uploads pre-recorded video (.mp4);

:System receives video;

:System analyzes video;

if (Seizure is detected?) then (Yes)
  :Display message "Seizures detected";
  :Display seizure timestamps;
else (No)
  :Display message "No seizures detected";
endif

:Overlay keypoints on video;

:Present video with keypoints and download results options;

partition UserActions {
  if (User downloads results?) then (Video)
    :User downloads video with overlays;
  elseif (User downloads results?) then (CSV)
    :User downloads CSV file with timestamps;
  endif
}

stop
@enduml
